# Copy or adjust the checked-in `.env*` files for your application.
# Keep secrets out of VITE_* variables; these values are exposed to the browser.

# .env
VITE_APP_TITLE=__APP_TITLE__
VITE_APP_NAMESPACE=__APP_NAME__

# .env.development
VITE_PORT=5173
VITE_BASE=/
VITE_GLOB_API_URL=/api
VITE_NITRO_MOCK=true
VITE_DEVTOOLS=false
VITE_INJECT_APP_LOADING=true
VITE_ROUTER_HISTORY=web
