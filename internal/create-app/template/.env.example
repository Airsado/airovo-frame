# Copy the checked-in environment files for local overrides.
# VITE_* values are public and are embedded in the browser bundle.
VITE_APP_TITLE=__APP_TITLE__
VITE_APP_NAMESPACE=__APP_NAME__
VITE_PORT=5173
VITE_BASE=/
VITE_GLOB_API_URL=/api
VITE_NITRO_MOCK=true
VITE_DEVTOOLS=false
VITE_INJECT_APP_LOADING=true
VITE_ROUTER_HISTORY=web
