{
    "name": "@airovo/create-airovo-app",
    "version": "0.0.0",
    "type": "module",
    "main": "src/index.ts",
    "bin": {
        "create-airovo-app": "./dist/index.js"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts --clean",
        "dev": "tsup src/index.ts --format esm --watch",
        "lint": "eslint \"**/*.ts\""
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "prompts": "^2.4.2"
    },
    "devDependencies": {
        "@airovo/typescript-config": "workspace:*",
        "@airovo/router": "workspace:*",
        "tsup": "^8.0.0",
        "typescript": "~6.0.2"
    }
}